# NARA CRM – environment for the PocketBase service.
# Copy to `.env` next to the `pocketbase` binary. Never commit `.env`.
# The systemd unit (deploy/pocketbase.service) loads this file with EnvironmentFile=.

# --- Required ---------------------------------------------------------------

# Public URL of the site (used in links and for the OAuth2 redirect).
CRM_APP_URL=https://crm.example.com

# Google OAuth2 Web client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI must be:  https://crm.example.com/api/oauth2-redirect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-character random string that encrypts stored settings (incl. the Google
# secret) inside pb_data. Generate with:  openssl rand -hex 16
# deploy/install.sh fills this in automatically if left empty.
PB_ENCRYPTION_KEY=

# --- Recommended ------------------------------------------------------------

# Google account that becomes the Director on first sign-in. If left empty,
# the very first Google account to sign in becomes the Director.
CRM_DIRECTOR_EMAIL=

# Soft memory limit for the Go runtime (helps on small VPS plans).
GOMEMLIMIT=512MiB

# --- Development only (never set in production) -----------------------------

# 1 = also allow e-mail/password login so the app can be tested without a
# Google OAuth client. Leave empty/0 in production.
CRM_DEV_PASSWORD_AUTH=

# --- Analytics / notifications (all optional) ---------------------------------

# Business time zone offset used for month boundaries of snapshots (Thailand = 7).
CRM_UTC_OFFSET_HOURS=7

# Weekly digest (Mondays 08:00 Bangkok) via LINE Messaging API.
# Token = channel access token of your LINE Official Account (Messaging API);
# TO = the userId or groupId that should receive the message.
NOTIFY_LINE_TOKEN=
NOTIFY_LINE_TO=

# Weekly digest via e-mail. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated recipients; default = Director and Assistant Managers.
NOTIFY_EMAIL_TO=
